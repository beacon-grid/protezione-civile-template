<Files .htaccess>
    Require all denied
</Files>

<FilesMatch "\.(env|git|sql|bak|log)$">
    Require all denied
</FilesMatch>

RewriteEngine On

RewriteCond %{HTTPS} !=on
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

RewriteCond %{REQUEST_URI} ^/emergenza$ [NC]
RewriteRule ^ /emergency.html [L,R=301]

RewriteCond %{REQUEST_URI} ^/notizie$ [NC]
RewriteRule ^ /news [L,R=301]

# Il wizard di installazione non usa URL senza estensione: dopo il setup
# deve restare raggiungibile solo come /setup.php, dove il gate applicativo
# restituisce 403 se la configurazione è già presente.
RewriteRule ^setup$ - [L]
RewriteRule ^setup\.php$ - [L]

# Redirect: rimuove .php e .html dagli URL visibili
RewriteCond %{THE_REQUEST} \s/+(.+?)\.(php|html)[\s?] [NC]
RewriteRule ^ /%1 [R=301,L]

# Rewrite interno .php
RewriteCond %{REQUEST_FILENAME}.php -f
RewriteRule ^([^\.]+)$ $1.php [NC,L]

# Rewrite interno .html
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^([^\.]+)$ $1.html [NC,L]

<IfModule mod_headers.c>
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
</IfModule>

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css application/javascript text/xml application/xml
</IfModule>

<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/jpg "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/gif "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType image/x-icon "access plus 1 year"
</IfModule>

ErrorDocument 401 /errors/401.php
ErrorDocument 404 /errors/404.php
ErrorDocument 403 /errors/403.php
ErrorDocument 500 /errors/500.php
ErrorDocument 503 /errors/503.php